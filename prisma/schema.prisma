// PostPilot schema — multi-tenant agency workspace on PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------
// AUTH
// ----------------------------------------

model Agency {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  demoMode       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clients        Client[]
  ghlConnection  GhLConnection?
  sessions       Session[]
  tokenEvents    TokenEvent[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  agencyId  String
  createdAt DateTime @default(now())
  expiresAt DateTime
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

// ----------------------------------------
// GHL INTEGRATION
// ----------------------------------------

model GhLConnection {
  id                  String   @id @default(uuid())
  agencyId            String   @unique
  mode                GhlMode  @default(DEMO)
  clientId            String?
  clientSecretEnc     String?
  accessTokenEnc      String?
  refreshTokenEnc     String?
  tokenType           String   @default("Agency")
  expiresAt           DateTime?
  scope               String?
  locationId          String? // agency-level company location if returned by GHL
  userId              String?
  lastRefreshedAt     DateTime?
  lastError           String?
  connectedAt         DateTime?
  updatedAt           DateTime @updatedAt
  agency              Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
}

enum GhlMode {
  DEMO
  LIVE
}

model TokenEvent {
  id        String   @id @default(uuid())
  agencyId  String
  kind      String // connect | refresh | refresh_error | revoke ...
  detail    String?
  createdAt DateTime @default(now())
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, createdAt])
}

model Client {
  id                 String   @id @default(uuid())
  name               String
  industry           String
  website            String?
  locationId         String? // GHL sub-account (location) id
  brandVoice         String   @default("professional")
  brandVoiceNotes    String?
  targetAudience     String?
  serviceArea        String?
  logoUrl            String?
  planStatus         PlanStatus @default(NOT_GENERATED)
  generatedUntil     DateTime? // last month generated so far
  schedulingCursor   DateTime? // next month to schedule via rolling window
  aiTokensEstimated  Int      @default(0)
  aiCostEstimated    Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  agencyId           String
  agency             Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  platforms          ClientPlatform[]
  products           Product[]
  blackoutDates      BlackoutDate[]
  posts              Post[]
  mediaAssets        MediaAsset[]
  platformAccounts   PlatformAccount[]
  scheduledRuns      ScheduledRun[]

  @@index([agencyId])
}

enum PlanStatus {
  NOT_GENERATED
  GENERATING
  GENERATED
}

model ClientPlatform {
  id         String   @id @default(uuid())
  clientId   String
  platform   String // facebook | instagram | linkedin | gbp | tiktok | youtube | twitter
  cadenceWeekly Int   @default(3)
  createdAt  DateTime @default(now())
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, platform])
}

model Product {
  id          String @id @default(uuid())
  clientId    String
  name        String
  description String
  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model BlackoutDate {
  id        String   @id @default(uuid())
  clientId  String
  date      DateTime @db.Date
  reason    String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model PlatformAccount {
  id         String   @id @default(uuid())
  clientId   String
  locationId String
  platform   String
  ghlAccountId   String
  accountName    String
  avatarUrl      String?
  lastSyncedAt   DateTime?
  createdAt      DateTime @default(now())
  client     Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, platform, ghlAccountId])
  @@index([clientId])
}

model ScheduledRun {
  id          String   @id @default(uuid())
  clientId    String
  monthStart  DateTime
  status      String   @default("completed") // completed | partial | failed
  scheduled   Int      @default(0)
  failed      Int      @default(0)
  detail      String?
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// ----------------------------------------
// CONTENT PLAN
// ----------------------------------------

enum PostStatus {
  DRAFT
  APPROVED
  SCHEDULED
  FAILED
  POSTED
}

model Post {
  id             String     @id @default(uuid())
  clientId       String
  platform       String
  scheduledDate  DateTime   @db.Date
  time           String     @default("09:00")
  body           String     @db.Text
  imagePrompt    String?    @db.Text
  videoScript    String?    @db.Text
  hashtags       String?
  status         PostStatus @default(DRAFT)
  contentTopic   String
  category       String // educational | promotional | social_proof | local_community | holiday_seasonal | behind_the_scenes
  mediaRequired  Boolean    @default(false)
  ghlAccountId   String? // platform account chosen for scheduling
  failureReason  String?
  failureDetail  String?
  scheduledAttempts Int    @default(0)
  scheduledAt    DateTime?
  ghlPostId      String?
  title          String? // youtube title
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  client         Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  media          PostMedia[]

  @@index([clientId, scheduledDate])
  @@index([clientId, status])
  @@index([platform])
}

model PostMedia {
  id        String   @id @default(uuid())
  postId    String
  mediaAssetId String
  order     Int      @default(0)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model MediaAsset {
  id          String   @id @default(uuid())
  clientId    String
  kind        String // image | video | youtube
  fileName    String?
  url         String? // local /uploads/... served url or youtube link
  ghlUrl      String? // CDN url returned by GHL upload
  ghlMediaId  String?
  mimeType    String?
  sizeBytes   Int?
  youtubeId   String?
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  usedInPosts PostMedia[]

  @@index([clientId])
}